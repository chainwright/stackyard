{
  "name": "stackyard",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm run build:player && vitest run",
    "typecheck": "tsc --noEmit",
    "dev:server": "node --import tsx/esm server/index.ts",
    "start": "NODE_ENV=production node --import tsx/esm server/index.ts",
    "dev:maker": "vite",
    "build:maker": "vite build",
    "preview:maker": "vite preview --port 4173",
    "build:player": "vite build --config vite.player.config.ts",
    "fonts:rename": "python3 scripts/rename-reading-font.py",
    "fonts:check": "python3 scripts/rename-reading-font.py --check",
    "check:invariants": "npm run build:player && vitest run tests/validator.property.test.ts tests/roundtrip.property.test.ts tests/shuffle-answers.test.ts tests/reachability.test.ts tests/player-size.test.ts",
    "check:decks": "node --import tsx/esm scripts/check-decks.ts",
    "check:export-opens": "node --import tsx/esm scripts/check-export-opens.ts",
    "check:claims": "node --import tsx/esm scripts/check-claims.ts",
    "check:mcp": "vitest run mcp/openverse/openverse.test.ts",
    "pick:images": "node --import tsx/esm scripts/pick-deck-images.ts",
    "pre-submit": "npm test && npm run typecheck && npm run build:maker && npm run check:claims"
  },
  "dependencies": {
    "preact": "11.1.1",
    "tsx": "4.19.2"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^26.6.6",
    "fast-check": "3.22.0",
    "jsdom": "^25.0.1",
    "typescript": "5.6.3",
    "vite": "^5.4.11",
    "vitest": "2.1.8"
  }
}
